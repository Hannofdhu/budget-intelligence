BUDGET_ENVIRONMENT=local
BUDGET_LOG_LEVEL=INFO
BUDGET_AUTH_MODE=dev_headers
# AI is local-only. The desktop launcher generates a shared API/Vite proxy proof.
# Build its isolated image first: docker build -t budget-pi-agent:1.2.0 apps/ai-agent
BUDGET_AI_AGENT_ENABLED=false
BUDGET_AI_AGENT_MODEL_CONFIG=~/.openclaw/openclaw.json
BUDGET_AI_AGENT_RUNTIME_ROOT=output/ai-agent
BUDGET_AI_AGENT_IMAGE=budget-pi-agent:1.2.0
BUDGET_AI_AGENT_BROWSER_ORIGIN=http://127.0.0.1:5188
BUDGET_DATABASE_URL=postgresql+asyncpg://budget:budget@127.0.0.1:54329/budget
BUDGET_API_HOST=127.0.0.1
BUDGET_API_PORT=8000
BUDGET_WORKER_ID=local-worker-1
BUDGET_WORKER_POLL_SECONDS=1
BUDGET_GUANCLI_BINARY=guancli
BUDGET_GUANCLI_PROFILE=default
BUDGET_GUANCLI_TIMEOUT_SECONDS=300
BUDGET_GUANCLI_RETRY_ATTEMPT_TIMEOUT_SECONDS=60
BUDGET_GUANCLI_RETRY_COUNT=2
BUDGET_GUANCLI_RETRY_BACKOFF_SECONDS=0.5
BUDGET_GUANCLI_MAX_CONCURRENT_QUERIES=2
BUDGET_FORECAST_REFRESH_TIMEOUT_SECONDS=180
# Asia/Shanghai 09:30, daily including weekends. Explicit local trial opt-in only.
# Requires BUDGET_LOCAL_TRIAL_ENABLED=true and the launcher-bound department.
# Worker must stay running; wakes/restarts catch up TODAY only. Drafts are never auto-confirmed.
# The desktop launcher also supports ignored output/local-trial/forecast-daily.json: {"enabled":true}.
# Explicit process environment takes precedence over that local opt-in; no global .env edit is needed.
BUDGET_FORECAST_DAILY_ENABLED=false
BUDGET_FORECAST_DAILY_MAX_ATTEMPTS=3
BUDGET_FORECAST_DAILY_RETRY_SECONDS=60
# Optional connector-only proxy. Never include credentials or commit a local proxy value.
# BUDGET_GUANCLI_PROXY_URL=http://proxy-host:proxy-port
BUDGET_SOURCE_PREVIEW_MAX_ROWS=500000
BUDGET_SOURCE_PREVIEW_CHUNK_MAX_ROWS=60000
BUDGET_SOURCE_PREVIEW_TARGET_ROWS=10000
BUDGET_SOURCE_CHAIN_MAX_LAG_MINUTES=180
BUDGET_AUDIT_ARCHIVE_MAX_BYTES=52428800
BUDGET_ROSTER_DATASET_ID=na942601c1371459eaf089f4
BUDGET_ROSTER_DATASET_NAME=智慧学习部学员花名册
BUDGET_SUMMARY_DATASET_ID=l932b728584e3496685341a5
BUDGET_SUMMARY_DATASET_NAME=智慧学习部指标汇总宽表
BUDGET_ROSTER_ETL_ID=g9bc9e7a162b04ca0bb207ac
BUDGET_SOURCE_FIELD_MAPPING_VERSION=zhihui-budget-source-v1
